# Runtime configuration
APP_ENV=development
LOG_LEVEL=INFO
MAX_RETRIES=2
DATABASE_PATH=data/database/lesson_generator.db
# Maximum evaluator Retry-After wait in seconds (1-3600; default 120).
EVALUATOR_MAX_RETRY_AFTER_SECONDS=120
# Comma-separated browser UI origins allowed to call the API.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Provider options: google or groq. Configure all three together.
# Example GroqCloud model: openai/gpt-oss-120b
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
